{
  "name": "cortico-world-buckshot",
  "version": "0.2.0",
  "type": "module",
  "description": "Buckshot Roulette game events and player actions for Cortico. 此乃直播测试验证之后的world，和其他 Persona / 非直播场景的兼容性有待测试。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phantivia/cortico-world-buckshot.git"
  },
  "homepage": "https://github.com/Phantivia/cortico-world-buckshot#readme",
  "keywords": [
    "cortico-world",
    "cortico",
    "buckshot-roulette"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "恶魔轮盘",
    "webUiClient": "dist/webui.js",
    "describe": "describe.json"
  },
  "files": [
    "src",
    "scripts",
    "dist",
    "describe.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:web": "esbuild src/webui/client.ts --bundle --format=esm --platform=browser --outfile=dist/webui.js",
    "prepack": "pnpm build:web",
    "check:game": "tsx scripts/check-game.ts",
    "check:native": "tsx scripts/check-native.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
